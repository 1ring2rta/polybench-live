  "components": {
    "schemas": {
      "AbstainRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "Request Id"
          },
          "market_id": {
            "type": "string",
            "pattern": "^[0-9]{1,30}$",
            "title": "Market Id"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "market_id",
          "reason"
        ],
        "title": "AbstainRequest"
      },
      "BaselineRequest": {
        "properties": {
          "model": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "BaselineRequest"
      },
      "BuyRequest": {
        "properties": {
          "market_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{1,30}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Market Id"
          },
          "market_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Market Url"
          },
          "request_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "Request Id"
          },
          "outcome": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Outcome"
          },
          "amount": {
            "type": "string",
            "maxLength": 25,
            "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,6})?$",
            "title": "Amount"
          },
          "max_price": {
            "type": "string",
            "maxLength": 8,
            "pattern": "^(0(\\.[0-9]{1,6})?|1(\\.0{1,6})?)$",
            "title": "Max Price",
            "default": "1"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "outcome",
          "amount"
        ],
        "title": "BuyRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KeyRequest": {
